# HardwareNeeds — environment variables
#
# Copy this file to .env.local and fill in real values there. .env.local is
# already git-ignored; never commit real API keys.
#
# The app works fully without any of these set — HardwareNeeds AI runs in
# deterministic fallback mode (real catalog data, rule-based answers, no
# model call) whenever OPENAI_API_KEY is missing. Setting it switches the
# assistant to "live" mode.

# Enables live AI responses via OpenAI. Optional — leave unset to use the
# deterministic fallback assistant.
OPENAI_API_KEY=

# Optional: override the OpenAI chat model used for live responses.
# Defaults to gpt-4o-mini if unset.
OPENAI_MODEL=gpt-4o-mini
